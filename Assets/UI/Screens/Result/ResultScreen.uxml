<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ResultScreen.uss" />
    <ui:VisualElement name="root" class="pp-page">
        <ui:VisualElement class="result__safe pp-safe-area">
            <ui:VisualElement class="pp-header">
                <ui:Button name="backButton" class="pp-icon-button">
                    <ui:VisualElement class="pp-icon pp-icon--chevron-left" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="解析結果" class="pp-header__title" />
                <ui:VisualElement class="pp-header__spacer" />
            </ui:VisualElement>

            <ui:ScrollView class="result__scroll">
                <ui:VisualElement class="result__content">
                    <ui:VisualElement class="pp-card pp-elevated result__summary">
                        <ui:VisualElement class="pp-icon-badge">
                            <ui:VisualElement class="pp-icon pp-icon--receipt pp-icon--primary" />
                        </ui:VisualElement>
                        <ui:VisualElement class="result__summary-body">
                            <ui:Label name="scannedAt" text="2026/09/25 12:34" class="pp-text-caption pp-text-sub" />
                            <ui:Label name="storeKind" text="スーパーでのお買い物" class="pp-text-bold" />
                            <ui:Label text="食料品" class="pp-chip result__category" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label text="購入したもの" class="pp-section-title" />
                    <ui:VisualElement name="items" class="pp-card pp-elevated result__items">
                        <ui:VisualElement class="pp-list-item">
                            <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                                <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pp-list-item__body">
                                <ui:Label text="牛乳" class="pp-list-item__title" />
                                <ui:Label text="乳製品" class="pp-list-item__sub" />
                            </ui:VisualElement>
                            <ui:Label text="0.27 kg" class="pp-list-item__trailing" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pp-list-item">
                            <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                                <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pp-list-item__body">
                                <ui:Label text="たまご" class="pp-list-item__title" />
                                <ui:Label text="たまご・肉類" class="pp-list-item__sub" />
                            </ui:VisualElement>
                            <ui:Label text="0.18 kg" class="pp-list-item__trailing" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pp-list-item">
                            <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                                <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pp-list-item__body">
                                <ui:Label text="食パン" class="pp-list-item__title" />
                                <ui:Label text="穀類" class="pp-list-item__sub" />
                            </ui:VisualElement>
                            <ui:Label text="0.16 kg" class="pp-list-item__trailing" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pp-list-item">
                            <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                                <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pp-list-item__body">
                                <ui:Label text="バナナ" class="pp-list-item__title" />
                                <ui:Label text="果物" class="pp-list-item__sub" />
                            </ui:VisualElement>
                            <ui:Label text="0.12 kg" class="pp-list-item__trailing" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pp-list-item pp-list-item--last">
                            <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                                <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                            </ui:VisualElement>
                            <ui:VisualElement class="pp-list-item__body">
                                <ui:Label text="ペットボトル飲料" class="pp-list-item__title" />
                                <ui:Label text="飲料" class="pp-list-item__sub" />
                            </ui:VisualElement>
                            <ui:Label text="0.11 kg" class="pp-list-item__trailing" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="pp-card pp-card--eco result__total">
                        <ui:Label text="今回の推定 CO₂ 排出量" class="pp-text-bold" />
                        <ui:VisualElement class="result__total-value">
                            <ui:Label name="totalValue" text="0.84" class="pp-text-display pp-text-heavy pp-text-eco" />
                            <ui:Label text="kg-CO₂e" class="pp-text-title pp-text-bold pp-text-eco result__total-unit" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="pp-card pp-elevated result__compare">
                        <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                            <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                        </ui:VisualElement>
                        <ui:VisualElement class="result__compare-body">
                            <ui:Label text="環境への影響の目安" class="pp-text-caption pp-text-sub" />
                            <ui:Label name="compareText" text="杉の木 約0.06本が1年で吸収する量" class="pp-text-bold" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement class="result__footer">
                <ui:Button name="applyButton" text="すみかに反映" class="pp-btn pp-btn--accent pp-btn--block" />
            </ui:VisualElement>
            <ui:VisualElement class="pp-safe-area__bottom" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
