<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="HomeScreen.uss" />
    <ui:VisualElement name="root" class="home" picking-mode="Ignore">
        <ui:VisualElement name="safeArea" class="home__safe pp-safe-area" picking-mode="Ignore">
            <ui:VisualElement name="header" class="home__header" picking-mode="Ignore">
                <ui:Button name="settingsButton" class="pp-icon-button">
                    <ui:VisualElement class="pp-icon pp-icon--gear pp-icon--sub" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="stats" class="home__stats" picking-mode="Ignore">
                <ui:VisualElement name="iceStat" class="pp-card pp-elevated pp-stat-card home__stat">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--snowflake pp-icon--primary" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pp-stat-card__body">
                        <ui:Label text="氷の量" class="pp-stat-card__label" />
                        <ui:VisualElement class="pp-stat-card__meter">
                            <ui:ProgressBar name="iceProgress" value="72" class="pp-progress" />
                            <ui:Label name="iceValue" text="72%" class="pp-stat-card__value pp-text-primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="co2Stat" class="pp-card pp-elevated pp-stat-card home__stat home__stat--last">
                    <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                        <ui:VisualElement class="pp-icon pp-icon--leaf pp-icon--eco" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pp-stat-card__body">
                        <ui:Label text="CO₂削減" class="pp-stat-card__label" />
                        <ui:VisualElement class="pp-stat-card__meter">
                            <ui:ProgressBar name="co2Progress" value="58" class="pp-progress pp-progress--eco" />
                            <ui:Label name="co2Value" text="58%" class="pp-stat-card__value pp-text-eco" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 開発ビルドと Editor だけで出す。ダミーの記録と時計の早送りでゲームの状態を動かす (HomeStatusPresenter) -->
            <ui:VisualElement name="demoControls" class="home__demo" picking-mode="Ignore">
                <ui:Label name="demoBadge" text="デモ用：時間を進めています" class="pp-badge pp-badge--accent home__demo-badge" />
                <ui:Button name="demoRecordButton" text="記録する" class="pp-chip home__demo-button" />
                <ui:Button name="demoAdvanceButton" text="1 日進める" class="pp-chip home__demo-button" />
            </ui:VisualElement>

            <ui:VisualElement name="worldViewport" class="home__world" picking-mode="Ignore" />

            <ui:VisualElement name="speech" class="pp-speech home__speech" picking-mode="Ignore">
                <ui:VisualElement class="pp-speech__bubble pp-elevated">
                    <ui:Label name="speechText" text="今日もいい天気だよ&#10;また来てね！" class="pp-speech__text" />
                </ui:VisualElement>
                <ui:VisualElement class="pp-avatar">
                    <ui:VisualElement class="pp-avatar__image pp-icon--penguin pp-icon pp-icon--original" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="pp-tab-bar-spacer" picking-mode="Ignore" />
            <ui:VisualElement class="pp-safe-area__bottom" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
