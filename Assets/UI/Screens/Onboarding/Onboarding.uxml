<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Onboarding.uss" />
    <ui:VisualElement name="root" class="onboarding">
        <ui:VisualElement class="onboarding__safe pp-safe-area">
            <!-- 上半分は透かして、後ろの 3D の島 (小屋の氷山とペンギン) を見せる -->
            <ui:VisualElement class="onboarding__hero" picking-mode="Ignore">
                <ui:Label text="ペンギンの島" class="pp-title-chip onboarding__logo" />
            </ui:VisualElement>
            <ui:VisualElement class="onboarding__card">
            <ui:VisualElement class="onboarding__dots">
                <ui:VisualElement name="dot0" class="onboarding__dot onboarding__dot--active" />
                <ui:VisualElement name="dot1" class="onboarding__dot" />
                <ui:VisualElement name="dot2" class="onboarding__dot" />
                <ui:VisualElement name="dot3" class="onboarding__dot" />
            </ui:VisualElement>

            <ui:VisualElement name="page0" class="onboarding__page">
                <ui:VisualElement class="pp-avatar onboarding__avatar">
                    <ui:VisualElement class="pp-avatar__image pp-icon pp-icon--penguin pp-icon--original" />
                </ui:VisualElement>
                <ui:Label text="ペンギンの島へようこそ！" class="pp-text-headline pp-text-heavy pp-text-center onboarding__title" />
                <ui:Label text="毎日のエコな行動で資源を集めて、ペンギンたちと島を育てよう。" class="pp-text-sub pp-text-center onboarding__text" />
                <ui:Label text="島の名前" class="pp-section-title" />
                <ui:TextField name="islandName" max-length="12" class="pp-text-field" />
            </ui:VisualElement>

            <ui:VisualElement name="page1" class="onboarding__page pp-hidden">
                <ui:Label text="3 つの決まり" class="pp-text-headline pp-text-heavy pp-text-center onboarding__title" />
                <ui:VisualElement class="pp-card pp-elevated onboarding__rule">
                    <ui:VisualElement class="pp-icon-badge pp-icon-badge--eco">
                        <ui:VisualElement class="pp-icon pp-icon--snowflake pp-icon--eco" />
                    </ui:VisualElement>
                    <ui:Label text="1 日 1 回記録すると、氷が増える" class="pp-text-bold onboarding__rule-text" />
                </ui:VisualElement>
                <ui:VisualElement class="pp-card pp-elevated onboarding__rule">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--warning pp-icon--point" />
                    </ui:VisualElement>
                    <ui:Label text="休むと氷が少し溶けて、島の端が沈む（記録すれば浮かぶ）" class="pp-text-bold onboarding__rule-text" />
                </ui:VisualElement>
                <ui:VisualElement class="pp-card pp-elevated onboarding__rule">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--penguin pp-icon--original" />
                    </ui:VisualElement>
                    <ui:Label text="ペンギンはいなくならない。いつでも戻っておいで" class="pp-text-bold onboarding__rule-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page2" class="onboarding__page pp-hidden">
                <ui:Label text="資源の集め方" class="pp-text-headline pp-text-heavy pp-text-center onboarding__title" />
                <ui:VisualElement class="pp-card pp-elevated onboarding__rule">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--camera pp-icon--primary" />
                    </ui:VisualElement>
                    <ui:Label text="エコ写真を 1 日 1 枚 → 電気・水（建てる・広げる）" class="pp-text-bold onboarding__rule-text" />
                </ui:VisualElement>
                <ui:VisualElement class="pp-card pp-elevated onboarding__rule">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--gas pp-icon--res-gas" />
                    </ui:VisualElement>
                    <ui:Label text="歩く → ガス（施設を動かす）" class="pp-text-bold onboarding__rule-text" />
                </ui:VisualElement>
                <ui:VisualElement class="pp-card pp-elevated onboarding__rule">
                    <ui:VisualElement class="pp-icon-badge">
                        <ui:VisualElement class="pp-icon pp-icon--allmighty pp-icon--res-allmighty" />
                    </ui:VisualElement>
                    <ui:Label text="ミッションを振り返る → オールマイティ（どれにでもなる）" class="pp-text-bold onboarding__rule-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page3" class="onboarding__page pp-hidden">
                <ui:VisualElement class="pp-avatar onboarding__avatar">
                    <ui:VisualElement class="pp-avatar__image pp-icon pp-icon--penguin pp-icon--original" />
                </ui:VisualElement>
                <ui:Label text="さっそく始めよう！" class="pp-text-headline pp-text-heavy pp-text-center onboarding__title" />
                <ui:Label text="まずは今日のエコ写真を撮って、資源を受け取ろう。海に面した所に漁場を建てると、お魚がとれるよ。" class="pp-text-sub pp-text-center onboarding__text" />
            </ui:VisualElement>

            <ui:VisualElement class="onboarding__footer">
                <ui:Button name="onboardingNext" text="次へ" class="pp-btn pp-btn--accent pp-btn--block" />
                <ui:Button name="onboardingLater" text="あとで撮る" class="pp-btn pp-btn--ghost pp-btn--block onboarding__later pp-hidden" />
            </ui:VisualElement>
            <ui:VisualElement class="pp-safe-area__bottom" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
