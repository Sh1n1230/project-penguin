# ---------------------------------------------------------------
# Unity
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Uu]serSettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# IDE / エディタが自動生成するもの (Unity が毎回作り直すためコミットしない)
# ---------------------------------------------------------------
.vs/
.idea/
.vscode/
.gradle/
.consulo/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------
# 秘密情報 (public リポジトリのため絶対にコミットしないこと)
#   API キーは FastAPI バックエンド側でのみ保持し、
#   Unity クライアントには一切埋め込まない設計。
# ---------------------------------------------------------------
.env
*.env
.env.*
!.env.example
!backend/.env.example
secrets.json
**/ApiKeys.cs
**/*.credentials*
*.pem
*.key

# ---------------------------------------------------------------
# ローカルデータ
#   端末上の SQLite にはユーザーの購買履歴が入りうるため必ず除外する。
#   ※レシート画像・購買明細を扱う機構は、生データを端末外へ出さない
#     方針で実装すること (README「プライバシー方針」参照)。
# ---------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------
# Python / FastAPI backend
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# ---------------------------------------------------------------
# Claude Code
#   CLAUDE.md / rules / hooks / settings.json はチームで共有し、
#   個人設定と実行時の生成物のみ除外する。
# ---------------------------------------------------------------
.claude/settings.local.json
.claude/*.local.*
.claude/hooks/__pycache__/
.agents/settings.local.json
.agents/*.local.*
CLAUDE.local.md

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
